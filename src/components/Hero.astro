---
import { useTranslations, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden">
  {/* Decorative atmosphere. pointer-events-none so it can never block a CTA. */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="backdrop-grid absolute inset-0 opacity-60"></div>
    <div
      class="accent-glow absolute -top-40 left-1/2 h-80 w-[46rem] -translate-x-1/2 rounded-full"
    >
    </div>
    <div class="accent-glow absolute top-40 -right-32 h-72 w-72 rounded-full">
    </div>
  </div>

  <div class="container-page pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="flex items-center gap-2.5">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--accent)] opacity-70"
        ></span>
        <span
          class="relative inline-flex h-2 w-2 rounded-full bg-[var(--accent)]"
        ></span>
      </span>
      <p class="eyebrow">{t('hero.eyebrow')}</p>
    </div>

    <h1
      class="mt-7 max-w-4xl text-[length:var(--text-hero)] leading-[0.98] font-bold tracking-[-0.04em] text-balance"
    >
      {t('hero.title')}<br />
      <span class="text-[var(--accent)]">{t('hero.titleAccent')}</span>
    </h1>

    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-secondary text-pretty">
      {t('hero.subtitle')}
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="#contact" class="btn-primary">
        {t('hero.ctaPrimary')}
        <span aria-hidden="true">→</span>
      </a>
      <a href="#example" class="btn-secondary">{t('hero.ctaSecondary')}</a>
    </div>
  </div>
</section>

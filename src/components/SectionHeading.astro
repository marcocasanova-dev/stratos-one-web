---
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  /** Centres the block. Used for the closing CTA, left-aligned everywhere else. */
  centered?: boolean;
  /**
   * Heading level. 2 everywhere except the one place per page that is the page's
   * own subject — /work, /capabilities, /contact and the legal pages each render
   * their opening block at level 1, because all three used to begin at <h2> and
   * shipped with no <h1> at all.
   */
  level?: 1 | 2;
}

const { eyebrow, title, sub, centered = false, level = 2 } = Astro.props;
const Heading = `h${level}` as const;
---

<div class:list={['max-w-3xl', centered && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading
    class="mt-3 text-[length:var(--text-section)] leading-[1.1] font-bold tracking-[-0.03em] text-balance"
  >
    {title}
  </Heading>
  {
    sub && (
      <p class="mt-5 text-lg leading-relaxed text-secondary text-pretty">
        {sub}
      </p>
    )
  }
</div>

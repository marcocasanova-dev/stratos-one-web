---
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  /** Centres the block. Used for the closing CTA, left-aligned everywhere else. */
  centered?: boolean;
}

const { eyebrow, title, sub, centered = false } = Astro.props;
---

<div class:list={['max-w-3xl', centered && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2
    class="mt-3 text-[length:var(--text-section)] leading-[1.1] font-bold tracking-[-0.03em] text-balance"
  >
    {title}
  </h2>
  {
    sub && (
      <p class="mt-5 text-lg leading-relaxed text-secondary text-pretty">
        {sub}
      </p>
    )
  }
</div>

---
import { SITE, PRINCIPAL } from '@/config';
import { offers } from '@/data/offers';
import {
  languages,
  localeCodes,
  hreflangCodes,
  switchLangPath,
  withBase,
  useTranslations,
  type Lang,
} from '@i18n/utils';

interface Props {
  /** Page title WITHOUT the brand. The brand suffix is appended here, once. */
  title: string;
  description: string;
  lang: Lang;
  /** Path relative to /public, or an absolute URL. */
  image?: string;
  noindex?: boolean;
  /** Emit the service/offer catalogue. Landing page only — one per site. */
  offerCatalog?: boolean;
}

const {
  title,
  description,
  lang,
  image = SITE.ogImage,
  noindex = false,
  offerCatalog = false,
} = Astro.props;

const t = useTranslations(lang);
const site = Astro.site ?? new URL(SITE.url);

/*
 * Trailing slash, to match what the build actually emits (`format: 'directory'`)
 * and what @astrojs/sitemap lists. This used to strip the slash, so every
 * canonical pointed at a URL that 301s to the real one — a mismatch that costs
 * nothing until a crawler decides which of the two to index.
 */
const canonicalPath = Astro.url.pathname.replace(/\/*$/, '/');
const canonical = new URL(canonicalPath, site);
const ogImage = new URL(withBase(image), site);

// One <link rel="alternate"> per locale, plus x-default pointing at English.
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  hreflang: hreflangCodes[code],
  href: new URL(switchLangPath(Astro.url, code), site).toString(),
}));

/*
 * One separator, one order, every page: "<page> | Stratos One". The page half
 * carries the keywords, so no page has to fall back to the tagline to say what
 * it is — which is what produced titles as thin as "Contact".
 */
const fullTitle = `${title} | ${SITE.name}`;

const serviceSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: new URL(withBase(`/${lang}/`), site).toString(),
  description,
  // Raw address — schema.org expects the value, not a mailto: URL.
  email: SITE.email,
  areaServed: ['DE', 'AT', 'EU'],
  serviceType: [
    'Software architecture consulting',
    'Web and mobile product engineering',
    'Data platform and API engineering',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: PRINCIPAL.city[lang],
    addressCountry: 'DE',
  },
  founder: {
    '@type': 'Person',
    name: PRINCIPAL.name,
    jobTitle: PRINCIPAL.role[lang],
    url: SITE.portfolio,
    sameAs: [SITE.github, SITE.linkedin],
  },
  sameAs: [SITE.portfolio, SITE.github, SITE.linkedin],
};

/*
 * The three engagements, and only on the landing page. No `price` is emitted:
 * the offers carry `price: null` until the owner confirms rates, and an
 * invented priceRange in structured data is a quote made by a template.
 */
if (offerCatalog) {
  serviceSchema.hasOfferCatalog = {
    '@type': 'OfferCatalog',
    name: t('offers.eyebrow'),
    itemListElement: offers.map((offer) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: offer.title[lang],
        description: offer.body[lang],
      },
    })),
  };
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}
<link
  rel="alternate"
  hreflang="x-default"
  href={alternates.find((a) => a.code === 'en')?.href}
/>

<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={localeCodes[lang]} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0e1420" />

<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />

<script
  type="application/ld+json"
  set:html={JSON.stringify(serviceSchema)}
  is:inline
/>

---
interface Props {
  /** Mark size in px. The wordmark scales with the surrounding font size. */
  size?: number;
  showWordmark?: boolean;
  class?: string;
}

const { size = 32, showWordmark = true, class: className = '' } = Astro.props;

// Gradient ids must be unique per instance or the second SVG on a page inherits
// the first one's definition and renders flat.
const gradientId = `s1-${Math.random().toString(36).slice(2, 9)}`;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    fill="none"
    aria-hidden="true"
    class="flex-none"
  >
    <defs>
      <linearGradient
        id={gradientId}
        x1="12"
        y1="14"
        x2="52"
        y2="52"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color="var(--color-accent-200)"></stop>
        <stop offset="1" stop-color="var(--color-accent-600)"></stop>
      </linearGradient>
    </defs>
    <rect width="64" height="64" rx="15" fill="var(--color-ink-950)"></rect>
    {/* Strata: shared layers under every product, narrowing to a single apex. */}
    <path d="M32 14 51 25 32 36 13 25z" fill={`url(#${gradientId})`}></path>
    <path
      d="M13 33.5 32 44.5 51 33.5"
      stroke={`url(#${gradientId})`}
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.62"></path>
    <path
      d="M13 42 32 53 51 42"
      stroke={`url(#${gradientId})`}
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.3"></path>
  </svg>

  {
    showWordmark && (
      <span class="text-[0.975rem] font-bold tracking-[-0.02em] whitespace-nowrap">
        Stratos<span class="text-[var(--accent)]">One</span>
      </span>
    )
  }
</span>

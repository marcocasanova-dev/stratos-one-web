---
import type { Project } from '@/data/projects';
import { SITE } from '@/config';
import { useTranslations, type Lang } from '@i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

/*
 * The long-form case study lives on the portfolio site, not here. That is the
 * de-duplication rule made structural: this card carries the summary and the
 * outcome, and anything deeper is one link away rather than a second copy.
 *
 * The link is rendered only when `caseStudy` says the destination exists. Three
 * of these cards used to promise "read the case study" and deliver a 404 on
 * marcocasanova.de, on the highest-intent click on the page — the moment a
 * prospect decides to check the evidence is the worst possible moment to break.
 */
const href = `${SITE.portfolio}/${lang}/work/${project.slug}`;

// A client label that just restates the title ("NIGHTOWL · 2025" above
// "NIGHTOWL") is noise, so it is dropped rather than deduplicated by hand in
// the data — the rule holds for entries added later too.
const client = project.client === project.title ? undefined : project.client;
const relationship = project.relationship
  ? t(`experience.${project.relationship}` as const)
  : undefined;
const eyebrow = [client, project.year].filter(Boolean).join(' · ');
---

<article
  class="agent-card h-full p-6"
  style={`--agent-hue: ${project.hue}`}
>
  {/*
    Meta row and title are siblings rather than nested, so the title always gets
    the full card width. Nesting it beside the status tag made a long tag
    squeeze the title into an extra line on one card and not its neighbours.
  */}
  <div class="flex items-start justify-between gap-3">
    <p class="eyebrow min-w-0">{eyebrow}</p>
    <span class="tag flex-none">{project.status[lang]}</span>
  </div>

  <h3 class="mt-3 text-lg leading-tight font-bold tracking-tight text-balance">
    {project.title}
  </h3>

  {relationship && <p class="mt-2 text-xs text-muted">{relationship}</p>}

  <p class="mt-4 text-sm leading-relaxed text-secondary">
    {project.summary[lang]}
  </p>

  <div class="mt-5 rounded-xl border border-subtle bg-sunken p-4">
    <p class="eyebrow">{t('work.outcome')}</p>
    <p class="mt-2 text-sm leading-relaxed text-secondary">
      {project.outcome[lang]}
    </p>
  </div>

  {/*
    .agent-card is a flex column, so mt-auto pushes this footer to the bottom
    and the role/stack/link block lines up across a row however long the
    summary above it runs.
  */}
  <div class="mt-auto pt-6">
    <p class="eyebrow">{t('work.role')}</p>
    <p class="mt-1.5 text-sm text-secondary">{project.role[lang]}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t('work.stack')}>
      {project.stack.map((item) => <li class="tag">{item}</li>)}
    </ul>

    {
      project.caseStudy && (
        <p class="mt-5 border-t border-subtle pt-4">
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="link-accent text-sm"
          >
            {t('work.caseStudy')} ↗
          </a>
        </p>
      )
    }
  </div>
</article>

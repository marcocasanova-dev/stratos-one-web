---
import Logo from '@components/Logo.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import LangPicker from '@components/LangPicker.astro';
import { localizePath, useTranslations, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const home = localizePath(lang);
/*
 * Real pages, not fragments, for work and capabilities: both now hold enough to
 * be worth their own URL, and a nav that scrolls a visitor down the landing
 * page cannot be linked to, shared, or ranked. `#offers` stays an anchor —
 * pricing shapes belong in the flow of the pitch, not on a page of their own.
 */
const links = [
  { href: localizePath(lang, 'work'), label: t('nav.work') },
  { href: `${home}#offers`, label: t('nav.offers') },
  { href: localizePath(lang, 'capabilities'), label: t('nav.capabilities') },
  { href: localizePath(lang, 'contact'), label: t('nav.contact') },
];
---

<header
  class="sticky top-0 z-40 border-b border-subtle bg-[var(--surface)]/80 backdrop-blur-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={home} class="transition-opacity hover:opacity-80">
      <Logo />
      <span class="sr-only">Stratos One</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-secondary transition-colors hover:text-[var(--text-primary)]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {/*
        The language control moves into the sheet below md. Three 44px segments
        plus two 44px buttons and the wordmark do not fit a 320px bar, and the
        thing that gets sacrificed to make them fit is always the tap area.
      */}
      <div class="hidden md:block">
        <LangPicker lang={lang} />
      </div>
      <ThemeToggle lang={lang} />
      <a
        href={localizePath(lang, 'contact')}
        class="btn-primary hidden !px-4 !py-2 sm:inline-flex"
      >
        {t('nav.cta')}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="icon-control md:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-subtle md:hidden">
    <nav class="container-page flex flex-col py-3" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex min-h-11 items-center border-b border-subtle text-sm text-secondary hover:text-[var(--text-primary)]"
          >
            {link.label}
          </a>
        ))
      }
      <div class="flex items-center justify-between gap-4 pt-4">
        <span class="eyebrow">{t('lang.switch')}</span>
        <LangPicker lang={lang} />
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Tapping a link inside the sheet should close it — on same-page anchors the
  // navigation does not repaint the header, so the panel would stay open.
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

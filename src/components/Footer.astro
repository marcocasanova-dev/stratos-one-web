---
import Logo from '@components/Logo.astro';
import { SITE, PRINCIPAL, isLegalComplete } from '@/config';
import { localizePath, useTranslations, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const home = localizePath(lang);
const siteLinks = [
  { href: `${home}#solutions`, label: t('nav.solutions') },
  { href: `${home}#how-it-works`, label: t('nav.howItWorks') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#contact`, label: t('nav.contact') },
];

/*
 * Legal links appear only once LEGAL in src/config.ts is complete — the pages
 * are not generated before then, and a footer link to a page that does not
 * exist is a worse footer than one without the link.
 */
const legalLinks = isLegalComplete
  ? [
      { href: localizePath(lang, 'imprint'), label: t('legal.imprintNav') },
      { href: localizePath(lang, 'privacy'), label: t('legal.privacyNav') },
    ]
  : [];
---

<footer class="mt-24 border-t border-subtle">
  <div class="container-page py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-sm leading-relaxed text-muted">
          {PRINCIPAL.city[lang]}, {PRINCIPAL.country[lang]} · {PRINCIPAL.timezone}
        </p>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          {t('footer.built')}
        </p>
      </div>

      <div class="flex flex-wrap gap-x-12 gap-y-6">
        <nav class="flex flex-col gap-2.5" aria-label={t('footer.navLabel')}>
          {
            siteLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm text-secondary hover:text-[var(--text-primary)]"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <div class="flex flex-col gap-2.5">
          <a
            href={`mailto:${SITE.email}`}
            class="text-sm text-secondary hover:text-[var(--text-primary)]"
            >{SITE.email}</a
          >
          <a
            href={SITE.portfolio}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-secondary hover:text-[var(--text-primary)]"
            >marcocasanova.de</a
          >
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-secondary hover:text-[var(--text-primary)]"
            >GitHub</a
          >
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-secondary hover:text-[var(--text-primary)]"
            >LinkedIn</a
          >
        </div>

        {
          legalLinks.length > 0 && (
            <nav class="flex flex-col gap-2.5" aria-label={t('footer.legalLabel')}>
              {legalLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm text-secondary hover:text-[var(--text-primary)]"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-subtle pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}. {t('footer.rights')}</p>
      <p>{t('footer.principal')}</p>
    </div>
  </div>
</footer>

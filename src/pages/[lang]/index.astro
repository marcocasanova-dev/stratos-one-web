---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ProjectCard from '@components/ProjectCard.astro';
import ContactForm from '@components/ContactForm.astro';
import { featuredProjects, projects } from '@/data/projects';
import { offers } from '@/data/offers';
import { workflowSteps, demo, peopleSplit, capabilities } from '@/data/automation';
import { SITE, PRINCIPAL } from '@/config';
import { languages, localizePath, useTranslations, type Lang } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

/*
 * ── Page order ──────────────────────────────────────────────────────────────
 * hero → starting workflow → demonstration → AI and people → packages →
 * experience → founder → contact.
 *
 * What is sold comes first and the evidence for the engineer comes after it:
 * a visitor should be able to name the workflow, the offer, the human handoff
 * and the next step before they reach a single past project.
 */
---

<BaseLayout
  lang={lang}
  title={t('seo.homeTitle')}
  description={t('seo.homeDesc')}
  offerCatalog
>
  <Hero lang={lang} />

  {/* ── Starting workflow ──────────────────────────────────────────────── */}
  <section id="solutions" class="scroll-mt-24 border-y border-subtle bg-sunken">
    <div class="container-page py-20 md:py-24">
      <div class="reveal">
        <SectionHeading
          eyebrow={t('start.eyebrow')}
          title={t('start.title')}
          sub={t('start.desc')}
        />
      </div>

      <div class="reveal mt-12">
        <h3 class="eyebrow">{t('start.workflowLabel')}</h3>
        {/* Vertical on phones, a wrapping grid above — nothing can overflow. */}
        <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            workflowSteps[lang].map((step, i) => (
              <li class="surface-card flex items-center gap-4 p-5">
                <span class="phase-step" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="font-semibold tracking-tight">{step}</span>
              </li>
            ))
          }
        </ol>
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-secondary">
          {t('start.support')}
        </p>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
          {t('start.channels')}
        </p>
      </div>

      <div class="reveal mt-14">
        <h3 class="eyebrow">{t('start.capsTitle')}</h3>
        <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            capabilities.map((cap) => (
              <li>
                <h4 class="font-bold tracking-tight">{cap.title[lang]}</h4>
                <p class="mt-2 text-sm leading-relaxed text-secondary">
                  {cap.body[lang]}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ── Demonstration ──────────────────────────────────────────────────── */}
  <section id="how-it-works" class="container-page scroll-mt-24 py-20 md:py-24">
    <div id="example" class="reveal scroll-mt-24">
      <SectionHeading eyebrow={t('demo.eyebrow')} title={t('demo.title')} />
      <p class="mt-6 inline-block rounded-lg border border-subtle bg-raised px-3 py-2 text-sm text-secondary">
        {t('demo.label')}
      </p>
    </div>

    <div class="reveal mt-10 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
      <div class="space-y-5">
        <article class="surface-card p-6">
          <h3 class="eyebrow">{t('demo.enquiryLabel')}</h3>
          <blockquote class="mt-3 text-lg leading-relaxed">
            {demo.enquiry[lang]}
          </blockquote>
        </article>

        <article class="surface-card p-6">
          <h3 class="eyebrow">{t('demo.collectsLabel')}</h3>
          <ul class="mt-4 space-y-2.5">
            {
              demo.collects[lang].map((item) => (
                <li class="flex gap-3 text-sm text-secondary">
                  <span
                    class="mt-[0.45rem] h-1 w-1 flex-none rounded-full bg-[var(--accent)]"
                    aria-hidden="true"
                  />
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>

      <div class="space-y-5">
        <article class="surface-card p-6">
          <h3 class="eyebrow">{t('demo.requestLabel')}</h3>
          <table class="mt-4 w-full text-left text-sm">
            <thead class="sr-only">
              <tr>
                <th scope="col">{t('demo.fieldHeader')}</th>
                <th scope="col">{t('demo.valueHeader')}</th>
              </tr>
            </thead>
            <tbody>
              {
                demo.request[lang].map(([field, value]) => (
                  <tr class="border-t border-subtle align-top">
                    <th
                      scope="row"
                      class="w-2/5 py-3 pr-4 text-left font-semibold text-muted"
                    >
                      {field}
                    </th>
                    <td class="py-3 text-secondary">{value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </article>

        <article class="surface-card p-6">
          <h3 class="eyebrow">{t('demo.handoffLabel')}</h3>
          <p class="mt-3 text-sm leading-relaxed text-secondary">
            {demo.handoff[lang]}
          </p>
        </article>
      </div>
    </div>

    <p class="reveal mt-6 max-w-3xl text-sm leading-relaxed text-muted">
      {t('demo.caption')}
    </p>

    {/* ── AI and people ─────────────────────────────────────────────────── */}
    <div class="reveal mt-20">
      <SectionHeading title={t('people.title')} />

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <article class="surface-card p-6">
          <h3 class="text-lg font-bold tracking-tight">{t('people.agentsHeader')}</h3>
          <ul class="mt-5 space-y-3">
            {
              peopleSplit.agents[lang].map((item) => (
                <li class="flex gap-3 text-sm text-secondary">
                  <span
                    class="mt-[0.45rem] h-1 w-1 flex-none rounded-full bg-[var(--accent)]"
                    aria-hidden="true"
                  />
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="surface-card p-6">
          <h3 class="text-lg font-bold tracking-tight">{t('people.peopleHeader')}</h3>
          <ul class="mt-5 space-y-3">
            {
              peopleSplit.people[lang].map((item) => (
                <li class="flex gap-3 text-sm text-secondary">
                  <span
                    class="mt-[0.45rem] h-1 w-1 flex-none rounded-full bg-[var(--text-muted)]"
                    aria-hidden="true"
                  />
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>

      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">
        {t('people.note')}
      </p>
    </div>
  </section>

  {/* ── Engagement packages ────────────────────────────────────────────── */}
  <section id="packages" class="scroll-mt-24 border-y border-subtle bg-sunken">
    <div class="container-page py-20 md:py-24">
      <div class="reveal">
        <SectionHeading eyebrow={t('packages.eyebrow')} title={t('packages.title')} />
      </div>

      <ol class="reveal mt-12 grid gap-5 md:grid-cols-2">
        {
          offers.map((offer, i) => (
            <li>
              <article
                class="agent-card h-full p-7"
                style={`--agent-hue: ${offer.hue}`}
              >
                <p class="eyebrow">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 text-xl font-bold tracking-tight">
                  {offer.title[lang]}
                </h3>
                <p class="mt-4 text-base leading-relaxed text-secondary">
                  {offer.body[lang]}
                </p>
                <p class="mt-5 text-sm leading-relaxed text-secondary">
                  <span class="font-semibold text-[var(--text-primary)]">
                    {`${offer.id === 'managed' ? t('packages.scopeLabel') : t('packages.outputsLabel')}:`}
                  </span>{' '}
                  {offer.outputs[lang]}
                </p>
                {offer.price && (
                  <p class="mt-5 font-mono text-sm">{offer.price[lang]}</p>
                )}
              </article>
            </li>
          ))
        }
      </ol>

      <div class="reveal mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href="#contact" class="btn-primary">
          {t('packages.cta')}
          <span aria-hidden="true">→</span>
        </a>
        <p class="max-w-2xl text-sm leading-relaxed text-muted">
          {t('packages.note')}
        </p>
      </div>
    </div>
  </section>

  {/* ── Relevant experience ────────────────────────────────────────────── */}
  <section id="experience" class="container-page scroll-mt-24 py-20 md:py-24">
    <div class="reveal">
      <SectionHeading title={t('experience.title')} sub={t('experience.sub')} />
    </div>

    <ul class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredProjects.map((project) => (
          <li>
            <ProjectCard project={project} lang={lang} />
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-8">
      <a href={localizePath(lang, 'work')} class="link-accent text-sm">
        {t('work.seeAll')} ({projects.length}) →
      </a>
    </div>
  </section>

  {/* ── Founder ────────────────────────────────────────────────────────── */}
  <section id="about" class="scroll-mt-24 border-y border-subtle bg-sunken">
    <div class="container-page py-20 md:py-24">
      <div
        class="reveal grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)] lg:items-start"
      >
        <div>
          <SectionHeading eyebrow={t('founder.eyebrow')} title={t('founder.title')} />
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary text-pretty">
            {t('founder.body')}
          </p>
          <p class="mt-5 max-w-2xl text-base font-semibold">
            {t('founder.accountability')}
          </p>
          <p class="mt-8">
            <a
              href={`${SITE.portfolio}/${lang}/`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              {t('founder.link')}
              <span aria-hidden="true">↗</span>
            </a>
          </p>
        </div>

        <aside class="surface-card p-7">
          <p class="text-lg font-bold tracking-tight">{PRINCIPAL.name}</p>
          <p class="eyebrow mt-1.5">{PRINCIPAL.role[lang]}</p>

          <dl class="mt-6 space-y-4 border-t border-subtle pt-6">
            <div>
              <dt class="eyebrow">{t('principal.locationLabel')}</dt>
              <dd class="mt-1.5 text-sm text-secondary">
                {PRINCIPAL.city[lang]}, {PRINCIPAL.country[lang]} · {PRINCIPAL.timezone}
              </dd>
            </div>
            <div>
              <dt class="eyebrow">{t('principal.marketsLabel')}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-secondary">
                {t('principal.marketsValue')}
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  {/* ── Contact ────────────────────────────────────────────────────────── */}
  <section id="contact" class="container-page scroll-mt-24 pt-20 pb-8 md:pt-24">
    <div class="reveal grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
      <div>
        <SectionHeading title={t('contact.heading')} sub={t('contact.sub')} />
        <p class="mt-8 text-sm text-muted">{t('contact.alsoTitle')}</p>
        <p class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" class="link-accent">
            {t('cta.call')} ↗
          </a>
          <a
            href={`mailto:${SITE.email}?subject=${encodeURIComponent(t('contact.emailSubject'))}`}
            class="link-accent"
          >
            {SITE.email}
          </a>
        </p>
        <p class="mt-6 max-w-md text-sm leading-relaxed text-muted">
          {t('contact.privacyNote')}
        </p>
      </div>
      <div class="surface-card p-6 md:p-8">
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>

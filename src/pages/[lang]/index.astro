---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { agents, phases } from '@/data/agents';
import { featuredProjects, projects } from '@/data/projects';
import { entryOffer, followOnOffers } from '@/data/offers';
import { situations } from '@/data/situations';
import { faq } from '@/data/faq';
import { SITE, PRINCIPAL } from '@/config';
import { languages, localizePath, useTranslations, type Lang } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent(t('contact.emailSubject'))}`;

/*
 * ── Page order ──────────────────────────────────────────────────────────────
 * hero → when this helps → proof → what you can buy → how it runs → the tracks
 * → who is accountable → objections → ask.
 *
 * The old order opened with six agent cards and reached the offer in seventh
 * place. That asks a buyer to learn a metaphor before they learn what is being
 * sold; this order answers "is this for me", "has he done it", "what does it
 * cost me to find out" in that sequence, which is the order those questions
 * actually occur to someone with a blocked release.
 */
---

<BaseLayout
  lang={lang}
  title={t('seo.homeTitle')}
  description={t('seo.homeDesc')}
  offerCatalog
>
  <Hero lang={lang} />

  {/* ── When this is useful ────────────────────────────────────────────── */}
  <section
    id="situations"
    class="scroll-mt-24 border-y border-subtle bg-sunken"
  >
    <div class="container-page py-20 md:py-24">
      <div class="reveal">
        <SectionHeading
          eyebrow={t('situations.eyebrow')}
          title={t('situations.title')}
        />
      </div>

      <ul class="reveal mt-12 grid gap-5 md:grid-cols-2">
        {
          situations.map((situation) => (
            <li class="surface-card p-7">
              <h3 class="text-lg font-bold tracking-tight">
                {situation.label[lang]}
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-secondary">
                {situation.body[lang]}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Selected work ──────────────────────────────────────────────────── */}
  <section id="work" class="container-page scroll-mt-24 py-20 md:py-24">
    <div class="reveal">
      <SectionHeading
        eyebrow={t('work.eyebrow')}
        title={t('work.title')}
        sub={t('work.sub')}
      />
    </div>

    {/*
      Three cards, not nine. The full portfolio moved to /work — nine cards on
      first contact diluted the three that are actually client systems in the
      sectors this sells into.
    */}
    <ul class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredProjects.map((project) => (
          <li>
            <ProjectCard project={project} lang={lang} />
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-8">
      <a href={localizePath(lang, 'work')} class="link-accent text-sm">
        {t('work.seeAll')} ({projects.length}) →
      </a>
    </div>
  </section>

  {/* ── Engagements ────────────────────────────────────────────────────── */}
  <section id="offers" class="scroll-mt-24 border-y border-subtle bg-sunken">
    <div class="container-page py-20 md:py-24">
      <div class="reveal">
        <SectionHeading
          eyebrow={t('offers.eyebrow')}
          title={t('offers.title')}
          sub={t('offers.sub')}
        />
      </div>

      <div
        class="reveal mt-12 grid gap-5 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]"
      >
        {/* The entry offer carries the detail — it is the one being sold. */}
        <article
          class="agent-card p-7 md:p-8"
          style={`--agent-hue: ${entryOffer.hue}`}
        >
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="text-xl font-bold tracking-tight">
              {entryOffer.title[lang]}
            </h3>
            <span class="tag">{entryOffer.duration[lang]}</span>
          </div>

          <p class="mt-5 text-base leading-relaxed text-secondary">
            {entryOffer.body[lang]}
          </p>

          {
            entryOffer.deliverables && (
              <div class="mt-7 rounded-xl border border-subtle bg-sunken p-5">
                <p class="eyebrow">{t('offers.includes')}</p>
                <ul class="mt-4 space-y-2.5">
                  {entryOffer.deliverables[lang].map((item) => (
                    <li class="flex gap-3 text-sm text-secondary">
                      <span
                        class="mt-[0.45rem] h-1 w-1 flex-none rounded-full bg-[var(--agent)]"
                        aria-hidden="true"
                      />
                      <span class="leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {entryOffer.price && <p class="mt-6 font-mono text-sm">{entryOffer.price[lang]}</p>}

          <p class="mt-7">
            <a href={localizePath(lang, 'contact')} class="btn-primary">
              {t('offers.cta')}
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </article>

        {/*
          content-start: the entry offer is much taller, and stretching these
          two to match it left the last card as a mostly-empty rectangle.
        */}
        <div class="grid content-start gap-5 sm:grid-cols-2 lg:grid-cols-1">
          {
            followOnOffers.map((offer) => (
              <article
                class="agent-card p-7"
                style={`--agent-hue: ${offer.hue}`}
              >
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h3 class="text-lg font-bold tracking-tight">
                    {offer.title[lang]}
                  </h3>
                  <span class="tag">{offer.duration[lang]}</span>
                </div>
                <p class="mt-5 text-sm leading-relaxed text-secondary">
                  {offer.body[lang]}
                </p>
                {offer.price && (
                  <p class="mt-5 font-mono text-sm">{offer.price[lang]}</p>
                )}
              </article>
            ))
          }
        </div>
      </div>

      <p class="reveal mt-8 max-w-2xl text-sm leading-relaxed text-muted">
        {t('offers.note')}
      </p>
    </div>
  </section>

  {/* ── How delivery runs ──────────────────────────────────────────────── */}
  <section id="process" class="container-page scroll-mt-24 py-20 md:py-24">
    <div class="reveal">
      <SectionHeading
        eyebrow={t('process.eyebrow')}
        title={t('process.title')}
        sub={t('process.sub')}
      />
    </div>

    <ol class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        phases.map((phase, i) => (
          <li class="surface-card flex flex-col p-6">
            <div class="flex items-center gap-3">
              <span class="phase-step" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="text-lg font-bold tracking-tight">
                {phase.label[lang]}
              </h3>
            </div>
            <p class="mt-5 flex-1 text-sm leading-relaxed text-secondary">
              {phase.body[lang]}
            </p>
            <p class="mt-5 border-t border-subtle pt-4">
              <span class="eyebrow">{t('process.led')}</span>
              <span class="mt-1.5 block font-mono text-sm text-[var(--accent)]">
                {phase.agent}
              </span>
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── Capability tracks ──────────────────────────────────────────────── */}
  <section
    id="capabilities"
    class="scroll-mt-24 border-y border-subtle bg-sunken"
  >
    <div class="container-page py-20 md:py-24">
      <div class="reveal">
        <SectionHeading
          eyebrow={t('caps.eyebrow')}
          title={t('caps.title')}
          sub={t('caps.sub')}
        />
      </div>

      {/*
        A compact index, not six full cards. The detail lives on /capabilities;
        here the tracks only have to be legible as a shape of work, because by
        this point the reader already knows what they would be buying.
      */}
      <ul class="reveal mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          agents.map((agent) => (
            <li class="flex items-start gap-4">
              <span
                class="agent-glyph flex-none"
                style={`--agent-hue: ${agent.hue}`}
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={agent.icon} />
                </svg>
              </span>
              <div class="min-w-0">
                <h3 class="font-bold tracking-tight">{agent.role[lang]}</h3>
                <p class="mt-1 font-mono text-xs text-muted">{agent.name}</p>
                <p class="mt-2 text-sm leading-relaxed text-secondary">
                  {agent.summary[lang]}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-10">
        <a href={localizePath(lang, 'capabilities')} class="link-accent text-sm">
          {t('caps.more')} →
        </a>
      </div>
    </div>
  </section>

  {/* ── Who is accountable ─────────────────────────────────────────────── */}
  <section class="container-page py-20 md:py-24">
    <div
      class="reveal grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)] lg:items-start"
    >
      <div>
        <SectionHeading
          eyebrow={t('principal.eyebrow')}
          title={t('principal.title')}
        />
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary text-pretty">
          {t('principal.body')}
        </p>

        <div class="mt-8 max-w-2xl rounded-xl border border-subtle bg-sunken p-6">
          <p class="eyebrow">{t('principal.aiPolicyLabel')}</p>
          <p class="mt-3 text-sm leading-relaxed text-secondary">
            {t('principal.aiPolicy')}
          </p>
        </div>

        <p class="mt-8">
          <a
            href={`${SITE.portfolio}/${lang}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            {t('principal.viewPortfolio')}
            <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>

      <aside class="surface-card p-7">
        <p class="text-lg font-bold tracking-tight">{PRINCIPAL.name}</p>
        <p class="eyebrow mt-1.5">{PRINCIPAL.role[lang]}</p>

        <dl class="mt-6 space-y-4 border-t border-subtle pt-6">
          <div>
            <dt class="eyebrow">{t('principal.locationLabel')}</dt>
            <dd class="mt-1.5 text-sm text-secondary">
              {PRINCIPAL.city[lang]}, {PRINCIPAL.country[lang]} · {PRINCIPAL.timezone}
            </dd>
          </div>
          <div>
            <dt class="eyebrow">{t('principal.stackLabel')}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-secondary">
              {t('principal.stackValue')}
            </dd>
          </div>
          <div>
            <dt class="eyebrow">{t('principal.marketsLabel')}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-secondary">
              {t('principal.marketsValue')}
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  {/* ── FAQ ────────────────────────────────────────────────────────────── */}
  <section id="faq" class="scroll-mt-24 border-y border-subtle bg-sunken">
    <div class="container-page py-20 md:py-24">
      <div class="reveal">
        <SectionHeading eyebrow={t('faq.eyebrow')} title={t('faq.title')} />
      </div>

      <div class="reveal mt-10 max-w-3xl border-t border-subtle">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>{item.question[lang]}</summary>
              <p class="pb-6 text-sm leading-relaxed text-secondary">
                {item.answer[lang]}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Closing CTA ────────────────────────────────────────────────────── */}
  <section class="container-page pt-20 pb-8 md:pt-24">
    <div class="reveal surface-card relative overflow-hidden px-6 py-16 md:px-12">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="accent-glow absolute -top-24 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full"
        >
        </div>
      </div>

      <div class="relative">
        <SectionHeading title={t('cta.title')} sub={t('cta.body')} centered />

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" class="btn-primary">
            {t('cta.call')}
            <span aria-hidden="true">→</span>
          </a>
          <a href={mailto} class="btn-secondary">
            {t('cta.email')}
          </a>
        </div>

        <p class="mt-6 text-center text-sm text-muted">{t('cta.response')}</p>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import AgentCard from '@components/AgentCard.astro';
import { agents, phases } from '@/data/agents';
import { SITE } from '@/config';
import { languages, localizePath, useTranslations, type Lang } from '@i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t('agentsPage.title')}
  description={t('agentsPage.sub')}
>
  <section class="relative overflow-hidden border-b border-subtle">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="backdrop-grid absolute inset-0 opacity-50"></div>
      <div
        class="accent-glow absolute -top-32 left-1/2 h-64 w-[38rem] -translate-x-1/2 rounded-full"
      >
      </div>
    </div>

    <div class="container-page py-16 md:py-20">
      <a href={localizePath(lang)} class="link-accent text-sm">
        ← {t('agentsPage.back')}
      </a>
      <div class="mt-6">
        <SectionHeading
          eyebrow={t('agents.eyebrow')}
          title={t('agentsPage.title')}
          sub={t('agentsPage.sub')}
        />
      </div>
    </div>
  </section>

  <section class="container-page py-16 md:py-20">
    <div class="grid gap-5 md:grid-cols-2">
      {agents.map((agent) => <AgentCard agent={agent} lang={lang} detailed />)}
    </div>
  </section>

  <section class="border-t border-subtle bg-sunken">
    <div class="container-page py-16 md:py-20">
      <SectionHeading
        eyebrow={t('how.eyebrow')}
        title={t('how.title')}
        sub={t('how.sub')}
      />

      <ol class="mt-12 space-y-4">
        {
          phases.map((phase, i) => (
            <li class="surface-card flex flex-col gap-4 p-6 sm:flex-row sm:items-start sm:gap-6">
              <span class="phase-step" aria-hidden="true">
                {i + 1}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <h3 class="text-lg font-bold tracking-tight">
                    {phase.label[lang]}
                  </h3>
                  <span class="font-mono text-xs text-[var(--accent)]">
                    {phase.agent}
                  </span>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-secondary">
                  {phase.body[lang]}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 flex flex-wrap gap-3">
        <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" class="btn-primary">
          {t('cta.call')}
          <span aria-hidden="true">→</span>
        </a>
        <a href={localizePath(lang, 'contact')} class="btn-secondary">
          {t('nav.contact')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

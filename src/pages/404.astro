---
import BaseLayout from '@layouts/BaseLayout.astro';
import { defaultLang, localizePath, useTranslations } from '@i18n/utils';

// GitHub Pages serves a single 404.html for the whole site, so it cannot know
// the visitor's locale. English is the honest default here.
const lang = defaultLang;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t('404.title')}
  description={t('404.subtitle')}
  noindex
>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-6xl font-bold tracking-tight text-[var(--accent)]">
      404
    </p>
    <h1 class="mt-6 text-[length:var(--text-section)] font-bold tracking-[-0.03em]">
      {t('404.title')}
    </h1>
    <p class="mt-4 max-w-md text-secondary">{t('404.subtitle')}</p>
    <a href={localizePath(lang)} class="btn-primary mt-8">
      {t('404.cta')}
      <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
